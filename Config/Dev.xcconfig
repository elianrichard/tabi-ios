// Dev configuration — local backend on the Simulator.
// Note: `//` starts a comment in xcconfig — even mid-value — so the `//` in a
// URL is built from a SLASH variable to avoid it being eaten.
//
// BASE_URL points at localhost, which only resolves on the Simulator. To run on
// a physical device, change API_HOST to your Mac's LAN IP (e.g. 192.168.x.x).

API_SCHEME = http
API_HOST = 127.0.0.1:8080
SLASH = /
BASE_URL = $(API_SCHEME):$(SLASH)$(SLASH)$(API_HOST)

// Same secret as the other envs; the local backend is expected to run with
// APP_ENV=development, which bypasses the X-Api-Secret check entirely.
API_SECRET_KEY = cx40TsowDQFm6kAO9JXCJYZvAFh7U7SEXRvb066aeW7OPBMxzBxGAg3eduO8IITM

// HTTP header field name that carries API_SECRET_KEY. Same across envs.
API_SECRET_HEADER = X-Api-Secret

CODE_SIGN_ENTITLEMENTS = Tabi Split/Tabi Split.entitlements

// Compile-time flags: DEV (and STAGING-like non-prod behavior if needed).
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEV
