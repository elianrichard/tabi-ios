// Copy to Config/Secrets.xcconfig (gitignored) and fill in the production
// X-Api-Secret. Included by Production.xcconfig via `#include? "Secrets.xcconfig"`.
// Xcode Cloud: set the PROD_API_SECRET_KEY secret; ci_scripts/ci_pre_xcodebuild.sh
// writes this file before the build.
API_SECRET_KEY = paste-production-secret-here
